# ---------------------------------------------------------------------------
# Configuração do back-end — copie este arquivo para .env e ajuste os valores
# ---------------------------------------------------------------------------

# --- Firebase / Firestore -------------------------------------------------
# Caminho do service account JSON baixado em:
# Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave
FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json
FIREBASE_PROJECT_ID=seu-projeto-firebase

# Prefixo opcional das coleções (ex.: "dev_" separa os dados de desenvolvimento)
FIRESTORE_PREFIX=

# Alternativa 1 — emulador local do Firestore (não precisa de credencial):
#   firebase emulators:start --only firestore
# FIRESTORE_EMULATOR_HOST=localhost:8080
#
# Alternativa 2 — sem nenhum Firebase, guardando tudo em memória (só para demo):
# FIRESTORE_BACKEND=memory

# --- Segurança ------------------------------------------------------------
SECRET_KEY=troque-esta-chave-por-uma-aleatoria
TOKEN_EXPIRACAO_HORAS=12
ADMIN_EMAIL=admin@parouai.com
ADMIN_SENHA=admin123

# --- Integração front-end -------------------------------------------------
CORS_ORIGINS=*
API_BASE_URL=http://localhost:8000
